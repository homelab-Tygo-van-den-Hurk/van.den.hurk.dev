---
import '#src/styles/global.css';
import icon from "#src/assets/icon.svg";

/** The properties each page must have. */
export interface Props {
  /** The description of the page. */
  description?: string;
  /** The title of the page. */
  title?: string;
}

const {
  title = "Let's share!",
  description = "You can rent subdomains of 'van.den.Hurk.dev'!",
  class: className = "",
  ...rest
} = Astro.props as Props & astroHTML.JSX.HtmlHTMLAttributes;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="darkreader-lock" />
    <meta name="author" content="Tygo van den Hurk" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Old+Standard+TT&family=Source+Serif+Pro&display=swap" rel="stylesheet">
    <link rel="canonical" href="https://van.den.hurk.dev/" />
    <slot name="head" />
  </head>
  <body class=`bg-background-0 w-screen min-h-screen flex items-center justify-center flex-col py-16 px-8 ${className ?? ''}` ..rest>
    <slot />
  </body>
</html>
